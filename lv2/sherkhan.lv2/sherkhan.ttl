@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<https://github.com/davidpinault2-crypto/Sher_Khan-#sherkhan>
    a lv2:Plugin , lv2:FilterPlugin ;
    doap:name "Sher Khan Filterbank" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R" ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 4 ; lv2:symbol "input" ; lv2:name "Input" ;
        lv2:default 0.55 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 5 ; lv2:symbol "input_eq" ; lv2:name "Input EQ (Hi Cut / Flat / Hi Boost)" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 6 ; lv2:symbol "fm" ; lv2:name "FM" ;
        lv2:default 0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 7 ; lv2:symbol "lfo_speed" ; lv2:name "LFO Speed" ;
        lv2:default 0.35 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 8 ; lv2:symbol "lfo_depth" ; lv2:name "LFO Depth" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 9 ; lv2:symbol "lfo_shape" ; lv2:name "LFO Shape (Sine / Saw / Sine Trig)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 10 ; lv2:symbol "lfo_f2" ; lv2:name "LFO F2 (Same / Inverted)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 11 ; lv2:symbol "attack" ; lv2:name "Attack" ;
        lv2:default 0.2 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 12 ; lv2:symbol "decay" ; lv2:name "Decay" ;
        lv2:default 0.4 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 13 ; lv2:symbol "sustain" ; lv2:name "Sustain" ;
        lv2:default 0.75 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 14 ; lv2:symbol "release" ; lv2:name "Release" ;
        lv2:default 0.4 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 15 ; lv2:symbol "env_mode" ; lv2:name "Env Mode (ADSR / AR / Follow)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 16 ; lv2:symbol "trig_mode" ; lv2:name "Trig Mode (Normal / SensiTrig / Limit)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 17 ; lv2:symbol "freq_1" ; lv2:name "Freq 1" ;
        lv2:default 0.54 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 18 ; lv2:symbol "reso_1" ; lv2:name "Reso 1" ;
        lv2:default 0.35 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 19 ; lv2:symbol "adsr_1" ; lv2:name "ADSR 1" ;
        lv2:default 0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 20 ; lv2:symbol "lbh_1" ; lv2:name "L-B-H 1" ;
        lv2:default 0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 21 ; lv2:symbol "corr_1" ; lv2:name "Corr 1" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 22 ; lv2:symbol "freq_2" ; lv2:name "Freq 2" ;
        lv2:default 1 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 23 ; lv2:symbol "reso_2" ; lv2:name "Reso 2" ;
        lv2:default 0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 24 ; lv2:symbol "adsr_2" ; lv2:name "ADSR 2" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 25 ; lv2:symbol "lbh_2" ; lv2:name "L-B-H 2" ;
        lv2:default 0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 26 ; lv2:symbol "corr_2" ; lv2:name "Corr 2" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 27 ; lv2:symbol "harmonics" ; lv2:name "Harmonics (Free / 1:1 / 2:3 / 1:2 / 1:3 / 1:4 / 1:5 / 1:6 / 1:8 / 1:10 / 1:12 / 1:16)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 28 ; lv2:symbol "par_ser" ; lv2:name "Par/Ser" ;
        lv2:default 1 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 29 ; lv2:symbol "am" ; lv2:name "AM" ;
        lv2:default 0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 30 ; lv2:symbol "byp_eff" ; lv2:name "Byp/Eff" ;
        lv2:default 1 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 31 ; lv2:symbol "output" ; lv2:name "Output" ;
        lv2:default 0.6667 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 32 ; lv2:symbol "grit" ; lv2:name "Grit" ;
        lv2:default 0.4 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] .
