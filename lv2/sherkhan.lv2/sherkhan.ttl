@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

<https://github.com/davidpinault2-crypto/Sher_Khan-#sherkhan>
    a lv2:Plugin , lv2:FilterPlugin ;
    doap:name "Sher Khan Filterbank" ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:port
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R" ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 4 ; lv2:symbol "drive" ; lv2:name "Drive" ;
        lv2:default 0.25 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 5 ; lv2:symbol "freq_a" ; lv2:name "Freq A" ;
        lv2:default 0.6 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 6 ; lv2:symbol "reso_a" ; lv2:name "Reso A" ;
        lv2:default 0.35 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 7 ; lv2:symbol "mode_a" ; lv2:name "Mode A (LP-BP-HP)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 8 ; lv2:symbol "freq_b" ; lv2:name "Freq B" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 9 ; lv2:symbol "reso_b" ; lv2:name "Reso B" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 10 ; lv2:symbol "mode_b" ; lv2:name "Mode B (LP-BP-HP)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 11 ; lv2:symbol "routing" ; lv2:name "Parallel" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 12 ; lv2:symbol "env_amt" ; lv2:name "Env Amount (-6..+6 oct)" ;
        lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 13 ; lv2:symbol "env_atk" ; lv2:name "Env Attack" ;
        lv2:default 0.1 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 14 ; lv2:symbol "env_rel" ; lv2:name "Env Release" ;
        lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 15 ; lv2:symbol "lfo_rate" ; lv2:name "LFO Rate" ;
        lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 16 ; lv2:symbol "lfo_amt" ; lv2:name "LFO Amount" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 17 ; lv2:symbol "grit" ; lv2:name "Grit" ;
        lv2:default 0.3 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 18 ; lv2:symbol "output" ; lv2:name "Output" ;
        lv2:default 0.6667 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 19 ; lv2:symbol "mix" ; lv2:name "Mix" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] .
