    {"key": "reso_a",   "name": "Reso A",      "min": 0, "max": 1, "default": 0.35},
    {"key": "mode_a",   "name": "Mode A",      "min": 0, "max": 1, "default": 0},
    {"key": "freq_b",   "name": "Freq B",      "min": 0, "max": 1, "default": 1},
    {"key": "reso_b",   "name": "Reso B",      "min": 0, "max": 1, "default": 0},
    {"key": "mode_b",   "name": "Mode B",      "min": 0, "max": 1, "default": 0},
    {"key": "routing",  "name": "Routing",     "options": ["Series", "Parallel"], "default": 0},
    {"key": "env_amt",  "name": "Env Amount",  "min": 0, "max": 1, "default": 0.5},
    {"key": "env_atk",  "name": "Env Attack",  "min": 0, "max": 1, "default": 0.1},
    {"key": "env_rel",  "name": "Env Release", "min": 0, "max": 1, "default": 0.3},
    {"key": "lfo_rate", "name": "LFO Rate",    "min": 0, "max": 1, "default": 0.3},
    {"key": "lfo_amt",  "name": "LFO Amount",  "min": 0, "max": 1, "default": 0},
    {"key": "grit",     "name": "Grit",        "min": 0, "max": 1, "default": 0.3},
